{
  "manifest_version": 2,
  "name": "Hide-Scrollbar-YouTube",
  "version": "1.2.0",
  "description": "Hides the scrollbar when viewing videos on YouTube",
  "icons": {
    "48": "icons/sb.png",
    "96": "icons/sb.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/watch*"
      ],
      "js": [
        "hide_scrollbar_youtube.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "carlos.martinez.medina1992@gmail.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}

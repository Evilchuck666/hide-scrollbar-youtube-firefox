{
  // Open the project through this file. Each piece of configuration is defined in one place only:
  //   - here: the folder and every setting (a workspace file accepts settings of any scope);
  //   - .vscode/extensions.json, .vscode/tasks.json, .vscode/launch.json: recommendations, tasks and debugging.
  // Keep "extensions", "tasks" and "launch" out of this file and don't add a .vscode/settings.json,
  // or VS Code would merge or override the same configuration from two sources.
  "folders": [
    {
      "name": "Hide-Scrollbar-YouTube",
      "path": "."
    }
  ],
  "settings": {
    // Same conventions as the existing sources: 2-space indentation, LF line endings, one final newline
    // and no trailing whitespace.
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,

    // Validation and completion for the add-on manifest.
    "json.schemas": [
      {
        "fileMatch": ["src/manifest.json"],
        "url": "https://json.schemastore.org/webextension.json"
      }
    ]
  }
}
